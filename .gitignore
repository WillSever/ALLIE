# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/
myenv/
venv/
env/

# IDE/editor
.vscode/
.idea/

# Local machine configs
configs/*local*.yaml
!configs/allie_base.yaml
!configs/allie_384x256.yaml

# Datasets stay local unless the owner intentionally force-adds them.
data/*
!data/.gitkeep
!data/README.md

# Publication checkpoint is intentionally tracked with Git LFS.
checkpoints/*
!checkpoints/.gitkeep
!checkpoints/allie_base.h5
!checkpoints/allie_384x256.h5

# Publication images are intentionally tracked.
results/*
!results/predictions/
!results/comparisons/
!results/predictions_384x256/
!results/comparisons_384x256/
!results/metrics/
!results/predictions/**
!results/comparisons/**
!results/predictions_384x256/**
!results/comparisons_384x256/**
!results/metrics/.gitkeep

# Local experiment outputs and local metrics are not published by default.
runs/
results/experiments/
checkpoints/experiments/
results/metrics/*
!results/metrics/.gitkeep

# Other model files stay local by default.
*.h5
!checkpoints/allie_base.h5
!checkpoints/allie_384x256.h5
*.keras
*.pth
*.pt

# Logs and local reports
*.log
*.csv
*.json
